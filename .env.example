git clone https://github.com/ssverdlik/DOTSS.git
cd DOTSS
cp .env.example .env
# Редактирует .env, вставляя реальные ключи
python manage.py runserver


SECRET_KEY=
DEBUG=True

# Яндекс OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/yandex/callback

# Email (если используется)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

